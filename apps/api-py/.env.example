# Trỏ vào CÙNG một database Postgres với apps/api (NestJS) — trong giai đoạn
# chuyển đổi từng module, schema vẫn do Prisma sở hữu (migration nằm ở
# apps/api/prisma/migrations), service Python này chỉ đọc/ghi qua SQLAlchemy,
# KHÔNG tự chạy migration riêng cho các bảng đã có bên Prisma.
DATABASE_URL="postgresql+psycopg://tms:tms@localhost:5455/tms_g3"

# Dùng chung giá trị dev với apps/api/.env.example để JWT của 2 service có thể
# verify lẫn nhau trong lúc chuyển đổi (không bắt buộc, chỉ tiện test).
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="8h"

# Cổng riêng, KHÔNG trùng apps/api (3011), chạy song song để chuyển đổi từng
# module — xem CLAUDE.md mục "Trạng thái triển khai hiện tại".
PORT=8011

# AI image extraction is disabled until data-sharing policy and provider are approved.
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_EXTRACTION_MODE=vlm_then_ocr
AI_IMAGE_HOST_ALLOWLIST=storage.example.com
AI_REQUEST_TIMEOUT_MS=30000
AI_VLM_ENDPOINT=
AI_VLM_API_KEY=
AI_VLM_MODEL=
AI_OCR_ENDPOINT=
AI_OCR_API_KEY=
